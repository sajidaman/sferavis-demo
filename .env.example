# OpenAI is used for Redium when configured. Keep API keys server-side:
# add them to your host's Environment Variables and never prefix with VITE_.
OPENAI_API_KEY="MY_OPENAI_API_KEY"
# Optional; defaults to gpt-4o-mini.
OPENAI_MODEL="gpt-4o-mini"

# Gemini remains available as a fallback if OPENAI_API_KEY is not set.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
